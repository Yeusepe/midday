diff --git a/lib/racconify-depth-guard.js b/lib/racconify-depth-guard.js
new file mode 100644
--- /dev/null
+++ b/lib/racconify-depth-guard.js
@@ -0,0 +1,25 @@
+'use strict';
+
+// Bound recursive walkers before entering the JavaScript call stack (CVE-2026-93687).
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 128 || seen.has(node) || seen.size >= 65536) {
+      const error = new RangeError('Brace expression exceeds safe AST bounds');
+      error.code = 'ERR_BRACES_AST_LIMIT';
+      throw error;
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      if (pending.length + node.nodes.length > 65536) {
+        const error = new RangeError('Brace expression exceeds safe AST bounds');
+        error.code = 'ERR_BRACES_AST_LIMIT';
+        throw error;
+      }
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
